# A 2 m wall section, 2.5 m high and 0.2 m thick. Its origin is at its bottom.
[[node]]
name = "Wall"
type = "StaticBody3D"

[[node]]
name = "Mesh"
parent = "."
type = "MeshInstance3D"
position = [0.0, 1.25, 0.0]
scale = [2.0, 2.5, 0.2]
mesh = { primitive = "cube" }
material = { color = "#b9b2a6", roughness = 0.85 }

[[node]]
name = "Shape"
parent = "."
type = "CollisionShape3D"
position = [0.0, 1.25, 0.0]
shape = { box = [2.0, 2.5, 0.2] }
