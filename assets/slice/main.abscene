# Night Relics' entry scene: the Game script loads `slice/level.abscene`, the HUD and the
# rules. Open this in the editor with the game's scripts to play the whole game:
#
#   cargo build -p ab-slice
#   cargo run -p ab-editor -- --scene slice/main.abscene --scripts target/debug/libab_slice.so

[[node]]
name = "Game"
type = "Node"
script = "Game"
